# SeekWell Backend Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE (REQUIRED)
# ===========================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
# LOCAL: Use your local PostgreSQL database
DATABASE_URL=postgresql://postgres:password@localhost:5432/seekwell_db

# PRODUCTION (Render): Your cloud PostgreSQL instance
# DATABASE_URL=postgresql://postgres:x{&auk:zx{vrIie4@34.171.10.156:5432/seekwell

# ===========================================
# JWT AUTHENTICATION (REQUIRED)
# ===========================================
# Secret key for JWT token signing
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-use-openssl-rand-hex-32

# JWT algorithm (HS256 recommended)
ALGORITHM=HS256

# Token expiration in minutes
# LOCAL: 1440 = 24 hours (convenient for development)
# PRODUCTION: 30 minutes (more secure)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===========================================
# CORS CONFIGURATION (REQUIRED)
# ===========================================
# Comma-separated list of allowed origins for CORS
# Include both local development and production URLs

# LOCAL: Allow local frontend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PRODUCTION (Render): JSON array format (note the quotes)
# ALLOWED_ORIGINS='["https://seekwell.vercel.app", "http://localhost:3000"]'

# ===========================================
# FRONTEND URL (REQUIRED)
# ===========================================
# Used for generating password reset links

# LOCAL: Your local frontend
FRONTEND_URL=http://localhost:3000

# PRODUCTION: Your Vercel deployment
# FRONTEND_URL=https://seekwell.vercel.app

# ===========================================
# ENVIRONMENT (OPTIONAL)
# ===========================================
# Options: development, production
ENVIRONMENT=development

# Enable debug mode (verbose logging)
# LOCAL: true (helpful for development)
# PRODUCTION: false (security best practice)
DEBUG=true

# ===========================================
# EMAIL CONFIGURATION (OPTIONAL)
# ===========================================
# Required only if using password reset functionality
# For Gmail: Use App Password (not regular password)
# Guide: https://support.google.com/accounts/answer/185833

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_FROM=noreply@seekwell.health

# ===========================================
# HUGGINGFACE API (OPTIONAL)
# ===========================================
# Required only for backend AI prediction endpoint
# Get token from: https://huggingface.co/settings/tokens
# Note: Frontend uses direct Gradio API, doesn't need this

HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxx

# ===========================================
# GOOGLE AI (OPTIONAL)
# ===========================================
# Required only for chatbot features
# Get API key from: https://makersuite.google.com/app/apikey

# Use your production key or create a separate one for local testing
GOOGLE_API_KEY=AIzaSyDeHnctQpsL4xmhgvlYhgbyn-OePwXTlm0
