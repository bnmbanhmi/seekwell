# SeekWell Frontend Environment Variables
# Copy this file to .env for custom configuration

# ===========================================
# BACKEND API URL (REQUIRED for local dev)
# ===========================================
# LOCAL: Point to your local backend
REACT_APP_BACKEND_URL=http://localhost:8000

# PRODUCTION (Vercel): Points to Render backend
# REACT_APP_BACKEND_URL=https://seekwell-backend.onrender.com

# ===========================================
# HUGGINGFACE SPACE URL (REQUIRED)
# ===========================================
# Direct Gradio API endpoint for AI predictions
REACT_APP_HUGGINGFACE_SPACE_URL=https://bnmbanhmi-seekwell-skin-cancer.hf.space

# ===========================================
# AI CONFIGURATION
# ===========================================
# Confidence threshold for AI predictions (0.0 to 1.0)
REACT_APP_AI_CONFIDENCE_THRESHOLD=0.8

# ===========================================
# APPLICATION ENVIRONMENT
# ===========================================
# Options: development, production
# LOCAL: development (enables debug logging)
REACT_APP_ENVIRONMENT=development

# PRODUCTION (Vercel)
# REACT_APP_ENVIRONMENT=production

# ===========================================
# FEATURE FLAGS
# ===========================================
# Enable offline mode with service worker
# LOCAL: false (easier debugging)
REACT_APP_ENABLE_OFFLINE_MODE=false

# PRODUCTION: true (better user experience)
# REACT_APP_ENABLE_OFFLINE_MODE=true

# Enable Progressive Web App features
# LOCAL: false (not needed for development)
REACT_APP_ENABLE_PWA=false

# PRODUCTION: true (installable app)
# REACT_APP_ENABLE_PWA=true
