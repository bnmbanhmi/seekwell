# SeekWell Frontend Environment Configuration Example
# Copy this file to .env.local and update the values

# Backend API URL
# Development: http://localhost:8000
# Production: https://seekwell-backend.onrender.com
REACT_APP_BACKEND_URL=http://localhost:8000

# HuggingFace AI Model URL
REACT_APP_HUGGINGFACE_SPACE_URL=https://bnmbanhmi-seekwell-skin-cancer.hf.space

# AI Configuration
REACT_APP_AI_CONFIDENCE_THRESHOLD=0.8

# Feature Flags
REACT_APP_ENABLE_OFFLINE_MODE=false
REACT_APP_ENABLE_PWA=false

# Environment (development, staging, production)
REACT_APP_ENVIRONMENT=development
